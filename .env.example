# Address Resolution Platform — Environment Variables Template

# AI & LLM Services
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-2.5-flash

# Database Settings
DUCKDB_PATH=./data/addresses.db
SAP_DSN=
GIS_DB_URL=

# Search Thresholds & Arbitration
TIER1_CONFIDENCE_THRESHOLD=0.92
TIER2_CONFIDENCE_THRESHOLD=0.88
MANUAL_REVIEW_THRESHOLD=0.75
DISCARD_THRESHOLD=0.50

# Fallback & Circuit Breaker Settings
LLM_FALLBACK_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# Observability & Logging
LOG_LEVEL=INFO
OTEL_EXPORTER_ENDPOINT=

# Server Configuration
API_KEY=test_api_key
PORT=8000
WORKERS=4
